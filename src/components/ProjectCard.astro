---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  href: string;
  title: string;
  image: string;
  gif?: string;
  index: number;
}

const { href, title, image, gif, index } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../public/images/*.{jpeg,jpg,png,gif}"
);

const isRemote = (src?: string) => !!src && /^https?:\/\//.test(src);

/**
 * Resuelve la fuente de una imagen:
 * - URL remota (ej. miniatura de YouTube): se usa tal cual.
 * - Ruta local: se busca en el glob y se optimiza con getImage.
 * - Vacía/undefined: devuelve null (el elemento no se renderiza).
 */
async function resolveSrc(
  src: string | undefined,
  format: "avif" | "webp"
): Promise<string | null> {
  if (!src) return null;
  if (isRemote(src)) return src;

  if (!images[src]) {
    throw new Error(
      `"${src}" does not exist in glob: "../../public/images/*.{jpeg,jpg,png,gif}"`
    );
  }

  const optimized = await getImage({ src: images[src](), format });
  return optimized.src;
}

const imageSrc = await resolveSrc(image, "avif");
const gifSrc = await resolveSrc(gif, "webp");
---

<div
  class="project-card flex items-stretch"
   
>
  <a
    href={`projects/${href}`}
    class="cursor-pointer w-full flex flex-col justify-stretch relative"
  >
    <h3 class="project-card__title text-white mb-1 uppercase line-clamp-1">
      <span class="mr-3">0{index + 1}</span>{" "}
      {title}
    </h3>
    <div
      class="project-card__images relative overflow-hidden h-full text-white text-sm"
    >
      {
        imageSrc && (
          <div
            class="project-card__image w-full h-full"
            style={`background-image: url(${imageSrc});`}
          />
        )
      }
      {
        gifSrc && (
          <div
            class="project-card__gif w-full h-full"
            style={`background-image: url(${gifSrc});`}
          />
        )
      }
    </div>
  </a>
</div>
<style lang="scss">
  h3 {
    font-size: 2.2375vw;

    @media (min-width: 468px) {
      font-size: 1.5625vw;
    }

    @media (min-width: 768px) {
      font-size: 0.78125vw;
    }
  }

  .project-card {
    grid-column-end: span 1;
    grid-row-end: span 1;
    min-height: 17vw;

    &:hover .project-card__gif {
      transition: opacity 0.5s;
      opacity: 1;
    }

    &__images {
      height: calc(25.7483vw + 10px);
      @media (min-width: 768px) {
        height: 100%;
      }
    }

    &__image,
    &__gif {
      position: absolute;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      transition: opacity 0.49s;
    }

    &__image {
      background-color: #161616;
    }

    &__gif {
      opacity: 0;
    }
  }

  .big {
    grid-column-end: span 2;
    grid-row-end: span 2;
    min-height: 34vw;
  }
</style>