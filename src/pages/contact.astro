---
// Layouts
import Layout from "../layouts/Layout.astro";

// Components
import Splash from "../components/Splash.astro";
---

<Layout title="Contacto | LARDOX">
  <main class="w-full min-h-[85vh] flex flex-col justify-between px-6 md:px-20 lg:px-28 pt-20 pb-16 text-white selection:bg-white selection:text-black overflow-hidden">
    
    {/* --- SECCIÓN SUPERIOR: TÍTULO EDITORIAL GIGANTE (Entrada Escalonada) --- */}
    <div class="max-w-5xl w-full mx-auto">
      <div class="space-y-4">
        <span class="text-xs font-mono uppercase tracking-[0.4em] text-neutral-500 block contact-elem-1">
          [ 04 — CONTACTO ]
        </span>
        <h1 class="text-6xl md:text-8xl font-light tracking-tighter uppercase leading-[0.88] contact-elem-2">
          Hablemos <br />
          <span class="text-neutral-500 font-normal">de tu proyecto.</span>
        </h1>
      </div>
      <p class="text-xl md:text-2xl font-light text-neutral-300 max-w-2xl mt-8 leading-relaxed contact-elem-3">
        Completa el brief rápido o contáctanos directamente. Estamos listos para elevar tu producción audiovisual al siguiente nivel.
      </p>
    </div>

    {/* --- SECCIÓN CENTRAL: FORMULARIO BRIEF + ACCESOS DIRECTOS (Scroll Reveal Lento) --- */}
    <div class="max-w-5xl w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-16 my-20 items-start scroll-reveal">
      
      {/* Columna Izquierda: Formulario minimalista de alta gama (7 columnas) */}
      <div class="lg:col-span-7">
        <form action="#" method="POST" class="space-y-8">
          
          <div class="space-y-2">
            <label for="name" class="text-xs font-mono uppercase tracking-[0.3em] text-neutral-400 block">
              // Tu Nombre o Empresa
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required
              placeholder="Ej. Juan Pérez / Marca X" 
              class="w-full bg-transparent border-b border-neutral-800 pb-3 text-lg text-white placeholder-neutral-700 focus:outline-none focus:border-white transition-colors duration-500"
            />
          </div>

          <div class="space-y-2">
            <label for="email" class="text-xs font-mono uppercase tracking-[0.3em] text-neutral-400 block">
              // Correo Electrónico
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              placeholder="correo@ejemplo.com" 
              class="w-full bg-transparent border-b border-neutral-800 pb-3 text-lg text-white placeholder-neutral-700 focus:outline-none focus:border-white transition-colors duration-500"
            />
          </div>

          <div class="space-y-2">
            <label for="service" class="text-xs font-mono uppercase tracking-[0.3em] text-neutral-400 block">
              // Tipo de Proyecto
            </label>
            <select 
              id="service" 
              name="service" 
              class="w-full bg-black border-b border-neutral-800 pb-3 text-lg text-neutral-300 focus:outline-none focus:border-white transition-colors duration-500 cursor-pointer"
            >
              <option value="produccion" class="bg-neutral-900 text-white">Producción Audiovisual / Comercial</option>
              <option value="vfx" class="bg-neutral-900 text-white">VFX y Postproducción</option>
              <option value="motion" class="bg-neutral-900 text-white">Motion Design</option>
              <option value="otro" class="bg-neutral-900 text-white">Otro tipo de colaboración</option>
            </select>
          </div>

          <div class="space-y-2">
            <label for="message" class="text-xs font-mono uppercase tracking-[0.3em] text-neutral-400 block">
              // Cuéntanos tu visión o presupuesto
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              required
              placeholder="Detalles clave, fechas o alcance del proyecto..."
              class="w-full bg-transparent border-b border-neutral-800 pb-3 text-lg text-white placeholder-neutral-700 focus:outline-none focus:border-white transition-colors duration-500 resize-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="px-8 py-4 bg-white text-black text-xs font-semibold tracking-[0.25em] uppercase hover:bg-neutral-200 transition-all duration-500 hover:scale-[1.02] cursor-pointer inline-block"
          >
            Enviar Mensaje ↗
          </button>

        </form>
      </div>

      {/* Columna Derecha: Canales directos y ubicación (5 columnas) */}
      <div class="lg:col-span-5 space-y-12 lg:pl-8 lg:border-l lg:border-neutral-900">
        
        <div class="space-y-3">
          <span class="text-xs font-mono uppercase tracking-[0.3em] text-neutral-500 block">
            // Línea Directa
          </span>
          <a 
            href="mailto:contacto@lardox.com" 
            class="text-xl font-light tracking-tight hover:text-neutral-400 transition-colors block break-all text-neutral-300"
          >
            contacto@lardox.com ↗
          </a>
          <a 
            href="https://wa.me/TU_NUMERO_AQUI" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xl font-light tracking-tight hover:text-neutral-400 transition-colors block text-neutral-300 pt-2"
          >
            WhatsApp Directo ↗
          </a>
        </div>

        <div class="space-y-3">
          <span class="text-xs font-mono uppercase tracking-[0.3em] text-neutral-500 block">
            // Redes Sociales
          </span>
          <div class="flex flex-col gap-2 text-sm uppercase font-mono tracking-widest text-neutral-400">
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram ↗</a>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">YouTube ↗</a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn ↗</a>
          </div>
        </div>

        <div class="space-y-2">
          <span class="text-xs font-mono uppercase tracking-[0.3em] text-neutral-500 block">
            // Ubicación
          </span>
          <p class="text-xl font-light text-white">
            Bogotá, Colombia
          </p>
        </div>

      </div>

    </div>

    {/* --- PIE DE PÁGINA INFERIOR MINIMALISTA --- */}
    <div class="max-w-5xl w-full mx-auto flex flex-col sm:flex-row justify-between items-start sm:items-center text-xs tracking-widest uppercase text-neutral-500 pt-8 border-t border-neutral-900 gap-4 scroll-reveal">
      <span>© 2026 LARDOX Studio. Todos los derechos reservados.</span>
      <span class="font-mono text-neutral-400">PRODUCCIÓN AUDIOVISUAL & MOTION DESIGN</span>
    </div>

  </main>
  <Splash />
</Layout>

{/* --- ESTILOS DE MOTION GRAPHICS DE ALTA GAMA --- */}
<style>
  /* Entrada escalonada de la sección superior */
  .contact-elem-1 {
    opacity: 0;
    transform: translateY(20px);
    animation: contactCinematicIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  .contact-elem-2 {
    opacity: 0;
    transform: translateY(30px);
    animation: contactCinematicIn 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards;
  }

  .contact-elem-3 {
    opacity: 0;
    transform: translateY(25px);
    animation: contactCinematicIn 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
  }

  @keyframes contactCinematicIn {
    0% {
      opacity: 0;
      transform: translateY(35px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Scroll Reveal lento y solemne para el formulario y el footer */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

{/* --- SCRIPT INTERSECTION OBSERVER --- */}
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll(".scroll-reveal").forEach(el => {
      observer.observe(el);
    });
  });
</script>