---
import Layout from "../../layouts/Layout.astro";
import { YouTube } from "astro-embed";
import projects from "../../data/projects.json";
import { getYouTubeId, getYouTubeTitle } from "../../utils/youtube";

// Una ruta por cada proyecto del JSON: agregar un video allá crea su página automáticamente
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { projectSlug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const title = await getYouTubeTitle(project.url_video, project.name);
const videoId = getYouTubeId(project.url_video);
---

<Layout title={title} />

<section class="project mt-28">
  <div
    class="project__container text-white w-full flex justify-center items-center"
  >
    <YouTube
      id={videoId}
      class="w-full max-w-[98%] md:max-w-[90%] 2xl:max-w-[1400px]"
    />
  </div>
</section>

<style lang="scss">
  .project__container {
    height: calc(80vh - 109px);
  }
</style>