---
// Layouts
import Layout from "../layouts/Layout.astro";

// Components
import Splash from "../components/Splash.astro";

// Data institucional actualizada del estudio
const infoParagraphs = [
  {
    tag: "[ SOBRE EL ESTUDIO ]",
    text: "Fundado en 2020 y liderado por el director Daniel Forero, LARDOX Studios es una casa productora y de postproducción enfocada en redefinir el estándar audiovisual comercial. Fusionamos el rigor del rodaje cinematográfico con la tecnología visual de última generación para crear piezas que rompen los límites de la producción tradicional."
  },
  {
    tag: "[ VANGUARDIA: MOTION DESIGN & IA ]",
    text: "No solo filmamos; expandimos la realidad. Nos especializamos en Motion Design avanzado, CGI, efectos visuales (VFX) y flujos de trabajo con Inteligencia Artificial generativa. Esta capacidad técnica interna nos permite resolver proyectos de alta complejidad, desde simulaciones 3D hasta la creación de entornos virtuales y narrativas impulsadas por algoritmos."
  },
  {
    tag: "[ IMPACTO & CLIENTES ]",
    text: "Nuestro enfoque en la excelencia técnica y estética nos ha consolidado como un aliado estratégico para marcas que exigen un nivel internacional. Hemos desarrollado propuestas y piezas visuales de alto perfil para clientes globales y marcas emergentes de gran impacto, incluyendo campañas y comerciales para HP y ¡Dios Mío! Coffee, entregando siempre resultados donde la innovación visual es la protagonista."
  }
];
---

<Layout title="INFO | LARDOX">
  <main class="w-full min-h-[85vh] flex flex-col justify-between px-6 md:px-20 lg:px-28 pt-20 pb-16 text-white selection:bg-white selection:text-black overflow-hidden">
    
    {/* --- SECCIÓN PRINCIPAL: BIOGRAFÍA CON ENTRADA CINEMATOGRÁFICA --- */}
    <section class="w-full max-w-[1480px] mx-auto flex flex-col lg:flex-row justify-between items-start gap-12 mt-12 mb-32">
      
      {/* Columna Izquierda: Título / Aside */}
      <div class="w-full lg:w-1/3 info-elem-1">
        <span class="text-xs font-mono uppercase tracking-[0.4em] text-neutral-500 block mb-3">
          [ 05 — ACERCA DE ]
        </span>
        <h1 class="text-3xl md:text-5xl font-light tracking-tight uppercase text-white">
          Biografía.
        </h1>
      </div>

      {/* Columna Derecha: Contenido con bloques y animación escalonada */}
      <div class="w-full lg:w-2/3 space-y-12 info-elem-2">
        {
          infoParagraphs.map((item, index) => (
            <div 
              class="space-y-3 scroll-reveal"
              style={`transition-delay: ${index * 150}ms;`}
            >
              <span class="text-xs font-mono uppercase tracking-[0.3em] text-neutral-500 block">
                {item.tag}
              </span>
              <p class="text-xl md:text-2xl font-light text-neutral-300 leading-relaxed">
                {item.text}
              </p>
            </div>
          ))
        }
      </div>

    </section>

    {/* --- PIE DE PÁGINA INFERIOR MINIMALISTA --- */}
    <div class="max-w-[1480px] w-full mx-auto flex flex-col sm:flex-row justify-between items-start sm:items-center text-xs tracking-widest uppercase text-neutral-500 pt-8 border-t border-neutral-900 gap-4 scroll-reveal">
      <span>© 2026 LARDOX Studio. Todos los derechos reservados.</span>
      <span class="font-mono text-neutral-400">PRODUCCIÓN AUDIOVISUAL & MOTION DESIGN</span>
    </div>

  </main>
  <Splash />
</Layout>

{/* --- ESTILOS DE MOTION GRAPHICS DE ALTA GAMA --- */}
<style>
  /* Entrada escalonada inicial */
  .info-elem-1 {
    opacity: 0;
    transform: translateY(20px);
    animation: infoCinematicIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  .info-elem-2 {
    opacity: 0;
    transform: translateY(30px);
    animation: infoCinematicIn 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards;
  }

  @keyframes infoCinematicIn {
    0% {
      opacity: 0;
      transform: translateY(35px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Scroll Reveal lento y solemne */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

{/* --- SCRIPT INTERSECTION OBSERVER --- */}
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll(".scroll-reveal").forEach(el => {
      observer.observe(el);
    });
  });
</script>